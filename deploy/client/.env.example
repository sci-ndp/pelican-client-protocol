# Public URL presented by the server's reverse proxy. The client converts
# https:// to wss:// automatically before opening the WebSocket.
STOMP_URL=https://stomp-server.chtcdev.chtc.io/ws
# The message-queue channel is <SUBSCRIPTION>/demo-events. Leave SUBSCRIPTION blank to use <CLIENT_ID>-sub.
SUBSCRIPTION=
EVENT_SOURCE=demo-events
CLIENT_ID=remote-client-1
HEARTBEAT_MS=10000

# Optional client-side fault simulation.
DROP_ACK_PERCENT=0
DISCONNECT_AFTER=0
UI_PORT=8000

# INFO shows summaries; DEBUG includes complete STOMP frames.
LOG_LEVEL=DEBUG

# Optional HTTP Basic Auth for the WebSocket endpoint.
STOMP_USERNAME=
STOMP_PASSWORD=
