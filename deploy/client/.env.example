# Public URL presented by the server's reverse proxy. The client converts
# https:// to wss:// automatically before opening the WebSocket.
STOMP_URL=https://cccc.xyz
DESTINATION=/origin/demo
CLIENT_ID=remote-client-1
HEARTBEAT_MS=10000

# Optional client-side fault simulation.
DROP_ACK_PERCENT=0
DISCONNECT_AFTER=0
UI_PORT=8000
